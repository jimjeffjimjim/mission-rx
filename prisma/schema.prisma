datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl", "linux-arm64-openssl-3.0.x", "windows"]
}

model InventoryItem {
  id                  String        @id @default(cuid())
  shelfLocation       String
  genericName         String
  brandName           String?
  chemicalName        String?
  dosage              String
  itemType            String
  stockUnit           String        @default("Bottles")
  subUnit             String        @default("pills")
  bottlesAvailable           Int           @default(0)
  pillsPerBottle             Int           @default(0)
  looseUnitsAvailable        Float         @default(0)
  initialBottlesAvailable    Int?          @default(0)
  initialLooseUnitsAvailable Float?        @default(0)
  expirationDate             String
  lotNumbers          String        @default("[]")
  directions          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  dispenseLogs        DispenseLog[]
}

model DispenseLog {
  id                      String        @id @default(uuid())
  itemId                  String
  item                    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantityChanged         Float
  actionType              String        // 'DISPENSE' | 'RESTOCK' | 'EDIT'
  userRole                String?       @default("STAFF")
  details                 String?
  dispensedUnit           String?
  dispensedBottles        Int?          @default(0)
  dispensedPillsPerBottle Int?          @default(0)
  lotNumbers              String?       @default("[]")
  isTestMode              Boolean?      @default(false)
  createdAt               DateTime      @default(now())
}

model InventoryBackup {
  id                String   @id @default(uuid())
  title             String
  createdAt         DateTime @default(now())
  itemCount         Int      @default(0)
  logCount          Int      @default(0)
  inventorySnapshot String   // JSON string
  logsSnapshot      String   // JSON string
  notes             String?
}

