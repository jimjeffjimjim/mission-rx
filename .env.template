# Mission RX Cloud Database & Real-Time Synchronization Configuration
# To link your Supabase Cloud Postgres Database, copy these variables into your Netlify Project Settings (or local .env file)

# 1. Supabase Postgres Connection String (found in Supabase Dashboard -> Project -> Database -> Connection string -> URI / Transaction Pooler)
# When set, Prisma automatically connects to cloud Postgres instead of local SQLite.
DATABASE_URL="postgresql://postgres.[your-project-id]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Cloud API Variables (found in Supabase Dashboard -> Project Settings -> API)
# These activate real-time device-to-device instant updates across all hospital computers, tablets, and phones.
NEXT_PUBLIC_SUPABASE_URL="https://[your-project-id].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
